PIVOT_DB_USER=pivot
PIVOT_DB_PASSWORD=change-me
PIVOT_DB_NAME=pivot
PIVOT_DB_PORT=5433
# Used by afp and the API (host-side connection):
PIVOT_DATABASE_URL=postgresql://pivot:change-me@127.0.0.1:5433/pivot
# Settings API (/api/v1/pivot/settings) is closed unless this is set; the Explorer's Settings page sends it.
PIVOT_ADMIN_TOKEN=
# Optional: encryption key for stored secrets (a Fernet key). Default is a generated file at DATA_DIR/pivot/secret.key.
# PIVOT_SECRET_KEY=
